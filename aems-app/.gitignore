# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# temp
.docker_temp_*
docker-images.**

# tmp/files
./tmp/

# editor config
.idea
# .vscode
.DS_Store
# claude
.claude/settings.local.json

# secrets — real values live only in .env.secrets, loaded by the root
# compose shim as an env_file. docker/secrets/backup/ holds the backup
# sidecar's age keypair (auto-generated on first boot); nothing under
# docker/secrets/ is ever committed.
.env.secrets
docker/secrets/

# backups
docker/backups/

# other
*.bat
*.log

# playwright
scripts/.auth/
scripts/playwright-report/
scripts/test-results/
