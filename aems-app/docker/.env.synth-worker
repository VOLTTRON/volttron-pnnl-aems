# Environment variables for the synthetic dev-data worker.
# Only active when the `synth` compose profile is selected.
#
# Runs one-time backfill of demo topology + 90 days of historian samples,
# then keeps the container alive so the ticker can append new samples.
INSTANCE_TYPE=synth
INSTANCE_NAME=SynthWorker
LOG_TRANSPORTS=${LOGGERS}

# Synthetic data knobs
SYNTHETIC_SEED=${SYNTHETIC_SEED:-aems-demo}
SYNTHETIC_HISTORIAN_DAYS=${SYNTHETIC_HISTORIAN_DAYS:-90}
SYNTHETIC_TICK_SECONDS=${SYNTHETIC_TICK_SECONDS:-60}
SYNTHETIC_CAMPUS_PREFIX=${SYNTHETIC_CAMPUS_PREFIX:-DEMO_}
SYNTHETIC_TICKER=true

# AEMS database (Prisma) — for topology upserts
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_SCHEMA=public
DATABASE_USERNAME=${DATABASE_USERNAME}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_NAME=${DATABASE_NAME}

# Historian database — for topics + data writes
HISTORIAN_HOST=historian
HISTORIAN_PORT=5432
HISTORIAN_NAME=historian
HISTORIAN_USER=historian
HISTORIAN_PASSWORD=${HISTORIAN_DATABASE_PASSWORD}
HISTORIAN_CONFIG_MAPPING_PATH=/app/config/historian-topic-map.json

# Nest boot dependencies (not used at rest but required for module init)
GRAPHQL_PUBSUB=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=${REDIS_USERNAME}
REDIS_PASSWORD=${REDIS_PASSWORD}
PASSWORD_STRENGTH=${PASSWORD_STRENGTH}
PASSWORD_VALIDATE=${PASSWORD_VALIDATE}
PROXY_PROTOCOL=${PROXY_PROTOCOL}
PROXY_HOST=${PROXY_HOST}
PROXY_PORT=${PROXY_PORT}

# Grafana / seed paths — unused here but required by config defaults
GRAFANA_CONFIG_PATH=
