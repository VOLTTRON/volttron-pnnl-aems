# Environment variables for seeders container
INSTANCE_TYPE=^seed
INSTANCE_NAME=Seeders
LOG_TRANSPORTS=${LOGGERS}
# Env-only-mode fallbacks for readSecret(). The docker secret files
# mounted at /run/secrets/<name> win when populated by secrets.sh;
# these forwards from .env kick in when the mount is the empty
# `.placeholder`.
SESSION_SECRET=${SESSION_SECRET}
JWT_SECRET=${JWT_SECRET}
WORKER_TOKEN=${WORKER_TOKEN}
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}
FILE_UPLOAD_PATH=/app/upload/
SERVICE_SEED_DATA_PATH=/app/seed/
# Disable Grafana dashboard configuration (not needed in seeders container)
GRAFANA_CONFIG_PATH=
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_SCHEMA=public
DATABASE_USERNAME=${DATABASE_USERNAME}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_NAME=${DATABASE_NAME}
PASSWORD_STRENGTH=${PASSWORD_STRENGTH}
PASSWORD_VALIDATE=${PASSWORD_VALIDATE}
PROXY_PROTOCOL=${PROXY_PROTOCOL}
PROXY_HOST=${PROXY_HOST}
PROXY_PORT=${PROXY_PORT}
GRAPHQL_PUBSUB=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=${REDIS_USERNAME}
REDIS_PASSWORD=${REDIS_PASSWORD}
SERVICE_SEED_BATCH_SIZE=10
GRAFANA_URL=http://grafana:3000
GRAFANA_CONFIG_PATH=/app/grafana/
